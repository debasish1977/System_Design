    {
      "id": "QLQIBqgtb9gK9ncFv274B",
      "type": "text",
      "x": 413.75390625,
      "y": 3786.5478515625,
      "width": 1059.375,
      "height": 460,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 1675076734,
      "version": 943,
      "versionNonce": 1346797474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792553040153,
      "created": 1792552124803,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n1. User can view the flash sale item\n2. Users can secure/reserve an available unit for a limited time while the sale is active\n3. Users who secure a unit can complete payment to purchase it\n\nNon Functional Requirements\n1. The system should be able to prevent overselling even when many people are trying to claim the same unit at the same moment\n2. The system should be able to handle millions of users arriving within seconds of the sale starting\n3. The system should be able to give users a fair opportunity to compete for the limited inventory\n\nCore Entitites\n1. Product\n2. Reservation\n3. Purchase\n4. User\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\n High Level Design\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n1. User can view the flash sale item\n2. Users can secure/reserve an available unit for a limited time while the sale is active\n3. Users who secure a unit can complete payment to purchase it\n\nNon Functional Requirements\n1. The system should be able to prevent overselling even when many people are trying to claim the same unit at the same moment\n2. The system should be able to handle millions of users arriving within seconds of the sale starting\n3. The system should be able to give users a fair opportunity to compete for the limited inventory\n\nCore Entitites\n1. Product\n2. Reservation\n3. Purchase\n4. User\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\n High Level Design\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
