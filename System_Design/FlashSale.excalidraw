    {
      "id": "wfyHwZn5GvBpa_IwbjPvf",
      "type": "text",
      "x": 412,
      "y": 1790.8338623046875,
      "width": 774.8951416015625,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 420399842,
      "version": 757,
      "versionNonce": 1372471074,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792406131905,
      "created": 1792405410051,
      "link": null,
      "locked": false,
      "text": "Core Requirements\n1. User can view the flash sale items\n2. Users can secure/reserve an available unit for a limited time\n3. Users who secure a unit can complete payment to purchase it\n\n\nNon Functional Requirements\n1. Correctness under contention\n2. The system should be able to handle millions of users arriving within seconds\n3. The system should be able to give users a fair opportunity to compete for the limited inventory\n\nCore Entitites\n1. Product/Item\n2. Reservation\n3. Purchase\n4. User\n\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\nHigh Level Design\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Requirements\n1. User can view the flash sale items\n2. Users can secure/reserve an available unit for a limited time\n3. Users who secure a unit can complete payment to purchase it\n\n\nNon Functional Requirements\n1. Correctness under contention\n2. The system should be able to handle millions of users arriving within seconds\n3. The system should be able to give users a fair opportunity to compete for the limited inventory\n\nCore Entitites\n1. Product/Item\n2. Reservation\n3. Purchase\n4. User\n\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\nHigh Level Design\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
