      "seed": 1138829602,
      "version": 949,
      "versionNonce": 768850082,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792379378294,
      "created": 1792378385807,
      "link": null,
      "locked": false,
      "text": "Core Requirements\n1. View flash sale item\n2. Reserve item, limited time\n3. Purchase reserved item\n\nNon Functional Requirements\n1. Correctness under contention\n2. Scalable to 10M users waiting same product\n3. Fairness\n\nCore Entitites\n1. Product\n2. Reservation\n3. Purchase\n4. User\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\nHigh Level Design\n\n\n\n\n\n       ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Requirements\n1. View flash sale item\n2. Reserve item, limited time\n3. Purchase reserved item\n\nNon Functional Requirements\n1. Correctness under contention\n2. Scalable to 10M users waiting same product\n3. Fairness\n\nCore Entitites\n1. Product\n2. Reservation\n3. Purchase\n4. User\n\nAPI/System Interface\nGET /products/:productId --> Product\nPOST /products/:productId/reservations --> Reservation\nPOST /reservations/:reservationId/purchases --> Purchase\n\nHigh Level Design\n\n\n\n\n\n       ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
